      "seed": 847545539,
      "version": 180,
      "versionNonce": 472569251,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794846732424,
      "link": null,
      "locked": false,
      "text": "the code implementing the API can be about anything, too.\nFor example, node.js, golang, java, rust, etc. all\ncould implement the same API and nobody would know the difference.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the code implementing the API can be about anything, too.\nFor example, node.js, golang, java, rust, etc. all\ncould implement the same API and nobody would know the difference.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
