      "updated": 1794847335788,
      "link": null,
      "locked": false,
      "text": ".NET 4 and earlier is called \"Legacy .NET\", \".NET Classic\", or (yuck) \"Framework\"\n.NET Core - which just means cross-platform - can run on windows, mac, linux, etc.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ".NET 4 and earlier is called \"Legacy .NET\", \".NET Classic\", or (yuck) \"Framework\"\n.NET Core - which just means cross-platform - can run on windows, mac, linux, etc.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
