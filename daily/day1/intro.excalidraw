      "isDeleted": false,
      "boundElements": null,
      "updated": 1794846683655,
      "link": null,
      "locked": false,
      "text": "Architecture:\n the part of your application\n that is hard to change.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Architecture:\n the part of your application\n that is hard to change.",
      "autoResize": true,
