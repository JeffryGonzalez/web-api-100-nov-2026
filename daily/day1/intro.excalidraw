    },
    {
      "id": "jUp211Ufj8XwAjzcqYBHm",
      "type": "text",
      "x": 514.5,
      "y": 1194,
      "width": 726,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
