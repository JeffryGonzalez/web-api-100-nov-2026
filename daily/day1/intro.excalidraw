      "boundElements": null,
      "updated": 1794846628466,
      "link": null,
      "locked": false,
      "text": "the client code calling this can be anything that can\nmake an HTTP request and process a response.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the client code calling this can be anything that can\nmake an HTTP request and process a response.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IdJ4hUHCPPOuHmioIeOzF",
      "type": "text",
      "x": 1.5,
      "y": 933,
      "width": 319,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
