    {
      "id": "zmPLRUYKic9OU5d-SdqVA",
      "type": "text",
      "x": 831,
      "y": 796,
      "width": 504.8197021484375,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1390869950,
      "version": 304,
      "versionNonce": 540582398,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795019629844,
      "link": null,
      "locked": false,
      "text": "\"Backend For Frontend\"\n\"BFF\"\n\n- for every frontend you have a tightly\ncoupled backend api\n\n- these are shipped together, tested together, etc.\n\n- only cookies are used to create secure sessions\nin the browser (SameSite, Strict, HTTPs, etc.)\n\n- No Tokens in the browser.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Backend For Frontend\"\n\"BFF\"\n\n- for every frontend you have a tightly\ncoupled backend api\n\n- these are shipped together, tested together, etc.\n\n- only cookies are used to create secure sessions\nin the browser (SameSite, Strict, HTTPs, etc.)\n\n- No Tokens in the browser.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
