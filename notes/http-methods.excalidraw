      "boundElements": [],
      "updated": 1795014255301,
      "text": "Properties",
      "fontSize": 30,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Properties",
      "lineHeight": 1.25,
      "baseline": 27,
