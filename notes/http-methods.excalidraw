      "updated": 1795014761979,
      "link": null,
      "locked": false,
      "text": "Kent Beck - TDD (don't change things, add things)\nSteve Klabnik - \"The answer to almost all API design challenges is to add another resource\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kent Beck - TDD (don't change things, add things)\nSteve Klabnik - \"The answer to almost all API design challenges is to add another resource\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
