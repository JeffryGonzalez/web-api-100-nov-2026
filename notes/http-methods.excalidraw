      "text": "GET /employees/{id}\n\n\n\n200 Ok\n\n{\n    \"id\": \"{id}\",\n    \"name\": \"Bob Smith\",\n    \"email\": \"bob@aol.com\",\n    \"phone\": \"444-1212\"\n    \"department\": \"DEV\"\n}\n\n",
